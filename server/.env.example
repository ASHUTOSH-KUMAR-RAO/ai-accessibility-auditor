NODE_ENV=development
PORT=4000
# Pooled connection (Supabase: Transaction pooler, port 6543, add ?pgbouncer=true)
DATABASE_URL=postgresql://accesslens:accesslens@localhost:5455/accesslens
# Direct connection used for migrations (Supabase: Direct / Session, port 5432)
DIRECT_URL=postgresql://accesslens:accesslens@localhost:5455/accesslens
# Comma-separated list of allowed browser origins (also used for the CSRF Origin check)
CLIENT_URL=http://localhost:5173
# Number of reverse-proxy hops to trust (Railway = 1). 0 = none.
TRUST_PROXY=0

# Auth — generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Both >= 32 chars and they MUST differ, otherwise the server refuses to start.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=7
# lax is right when the frontend proxies /api/* (Vercel rewrite) so cookies are first-party.
# Cookies are always `Secure` in production.
COOKIE_SAMESITE=lax
