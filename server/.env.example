NODE_ENV=development
PORT=4000
# Pooled connection (Supabase: Transaction pooler, port 6543, add ?pgbouncer=true)
DATABASE_URL=postgresql://accesslens:accesslens@localhost:5455/accesslens
# Direct connection used for migrations (Supabase: Direct / Session, port 5432)
DIRECT_URL=postgresql://accesslens:accesslens@localhost:5455/accesslens
# Comma-separated list of allowed browser origins (also used for the CSRF Origin check)
CLIENT_URL=http://localhost:5173
# Number of reverse-proxy hops to trust (Railway = 1). 0 = none.
TRUST_PROXY=0

# Auth — generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Both >= 32 chars and they MUST differ, otherwise the server refuses to start.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=7
# lax is right when the frontend proxies /api/* (Vercel rewrite) so cookies are first-party.
# Cookies are always `Secure` in production.
COOKIE_SAMESITE=lax

# Scan engine
# Set false on instances that should only serve the API (another instance runs the worker)
SCAN_WORKER_ENABLED=true
SCAN_CONCURRENCY=2
SCAN_RATE_LIMIT_PER_HOUR=10
SCAN_MAX_ACTIVE_PER_USER=2
SCAN_NAV_TIMEOUT_MS=30000
SCAN_TOTAL_TIMEOUT_MS=60000
# Abort pages that download more than this many bytes
SCAN_MAX_PAGE_BYTES=30000000

# AI fixes (Groq). Leave GROQ_API_KEY empty to run in guided-fix (no AI) mode.
GROQ_API_KEY=
GROQ_MODEL_FAST=openai/gpt-oss-20b
GROQ_MODEL_SMART=openai/gpt-oss-120b
AI_TIMEOUT_MS=25000
# Per-user budget of AI generations (cache hits are free)
AI_RATE_LIMIT_PER_HOUR=30
AI_MAX_CONCURRENT=4

# ── Database pool ──
# Connections held by ONE instance. Keep it small on Supabase (its pooler has a limited connection budget).
DB_POOL_MAX=5

# ── Tests ──
# The test suites only ever run against this LOCAL database (they refuse any non-localhost URL).
# Start it with `docker compose up -d`, then run the migrations against it once:
#   DATABASE_URL=<this> DIRECT_URL=<this> npx prisma migrate deploy
TEST_DATABASE_URL=postgresql://accesslens:accesslens@localhost:5455/accesslens
TEST_DIRECT_URL=postgresql://accesslens:accesslens@localhost:5455/accesslens

# Production notes (see docs/DEPLOY.md): NODE_ENV=production, TRUST_PROXY=1, COOKIE_SAMESITE=lax,
# SCAN_CONCURRENCY=1 (the production default), fresh JWT secrets, CLIENT_URL = your Vercel origin(s).
