# Same-origin by default: Vite proxies /api to the server in dev, a Vercel rewrite does it in production.
# Only set a full URL if you deliberately bypass the proxy (cookies then become cross-site).
VITE_API_URL=/api

# Live scan progress (Socket.io). Empty = same origin (dev proxy). Vercel rewrites cannot proxy WebSocket
# upgrades, so in production set this to the API's own origin, e.g. https://your-api.up.railway.app
VITE_SOCKET_URL=

# Public origin of the site: used for canonical links, Open Graph tags, sitemap.xml and robots.txt.
# Set it to the real domain in production.
VITE_SITE_URL=http://localhost:5173
